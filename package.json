{
  "name": "electron-donuts",
  "version": "1.0.0",
  "description": "Electron Donuts",
  "main": "main.js",
  "scripts": {
    "compile": "webpack --config webpack.config.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "start": "electron ."
  },
  "build": {
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesourorange/electron-donuts.git"
  },
  "keywords": [
    "Electron",
    "Donut",
    "Analysis"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.2.0",
    "papaparse": "^4.6.0"
  },
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "22.14.13",
    "node": "22.22.3",
    "webpack":  "5.88.2",
    "webpack-dev-server": "4.15.1",
    "webpack-cli": "5.1.4"
  },
  "bugs": {
    "url": "https://github.com/thesourorange/electron-donuts/issues"
  },
  "homepage": "https://github.com/thesourorange/electron-donuts#readme"
}
